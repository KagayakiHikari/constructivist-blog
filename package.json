    "db:init": "npm run db:generate && npm run db:create && npm run db:seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.28",
    "prisma": "6.12.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.13",
    "typescript": "5.7.3"
  }

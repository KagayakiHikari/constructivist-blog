{
  "name": "constructivist-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:init && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:create": "node scripts/init-db.mjs",
